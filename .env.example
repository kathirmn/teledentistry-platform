# Server Ports
PORT=3000
HTTPS_PORT=3443

# Xirsys WebRTC STUN/TURN Server Configuration (Replace with your credentials)
XIRSYS_GATEWAY=https://global.xirsys.net
XIRSYS_IDENT=your_xirsys_ident
XIRSYS_SECRET=your_xirsys_secret
XIRSYS_CHANNEL=your_xirsys_channel

# Optional LiveKit SFU (for large-scale multi-mentor calls)
# LIVEKIT_URL=wss://your-livekit-server.com
# LIVEKIT_API_KEY=your_api_key
# LIVEKIT_API_SECRET=your_api_secret
